{
  "name": "qwen-workspace",
  "version": "0.39.0",
  "description": "Desktop coding workspace powered by Qwen (Ollama, LM Studio, or any OpenAI-compatible API)",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable zip --x64",
    "dist:zip": "electron-builder --win zip",
    "test": "node --test test/*.test.js",
    "test:e2e": "node test/e2e-smoke.mjs",
    "test:e2e:agent": "node test/e2e-agent.mjs",
    "test:e2e:nodes": "node test/e2e-nodes.mjs",
    "test:e2e:escalation": "node test/e2e-escalation.mjs",
    "test:e2e:highperf": "node test/e2e-highperf.mjs",
    "test:e2e:claudecode": "node test/e2e-claudecode.mjs",
    "test:e2e:planfirst": "node test/e2e-planfirst.mjs",
    "test:e2e:github": "node test/e2e-github.mjs",
    "test:e2e:recipes": "node test/e2e-recipes.mjs",
    "test:e2e:lessons": "node test/e2e-lessons.mjs",
    "test:e2e:toolargs": "node test/e2e-toolargs.mjs",
    "test:e2e:remote": "node test/e2e-remote.mjs",
    "test:e2e:review": "node test/e2e-review.mjs",
    "dist:mac": "electron-builder --mac dmg zip",
    "test:e2e:steer": "node test/e2e-steer.mjs",
    "test:e2e:goal": "node test/e2e-goal.mjs",
    "test:e2e:hardening": "node test/e2e-hardening.mjs",
    "test:e2e:projecttools": "node test/e2e-projecttools.mjs",
    "test:e2e:memory": "node test/e2e-memory.mjs",
    "test:e2e:checks": "node test/e2e-checks.mjs",
    "test:e2e:vision": "node test/e2e-vision.mjs",
    "test:e2e:skills": "node test/e2e-skills.mjs",
    "test:e2e:checksgate": "node test/e2e-checksgate.mjs",
    "test:e2e:subagents": "node test/e2e-subagents.mjs",
    "test:e2e:guiapp": "node test/e2e-guiapp.mjs",
    "test:e2e:progress": "node test/e2e-progress.mjs",
    "test:e2e:mcpimages": "node test/e2e-mcpimages.mjs",
    "test:e2e:gpufit": "node test/e2e-gpufit.mjs",
    "test:e2e:lmstudio": "node test/e2e-lmstudio.mjs",
    "test:e2e:checkapi": "node test/e2e-checkapi.mjs"
  },
  "author": "",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.9",
    "marked": "^18.1.1",
    "monaco-editor": "^0.57.0"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.64.1"
  },
  "productName": "Qwen Workspace",
  "build": {
    "appId": "com.qwenworkspace.app",
    "productName": "Qwen Workspace",
    "files": [
      "src/**/*",
      "templates/**/*",
      "package.json",
      "!node_modules/monaco-editor/{dev,esm,min-maps}/**",
      "!node_modules/monaco-editor/node_modules/**",
      "!**/*.map"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "artifactName": "Qwen-Workspace-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Qwen-Workspace-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Qwen-Workspace-${version}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MrRobotto512",
        "repo": "Qwen-Workspace"
      }
    ],
    "afterPack": "build/after-pack.js",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Qwen Workspace connects to Ollama servers on your other computers (the nodes you add in Settings) and serves remote sessions to your paired devices."
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MrRobotto512/Qwen-Workspace.git"
  }
}
